# radix-router: routes share prefixes in one tree; a lookup walks the path once.
# Render: d2 docs/radix-router.d2 docs/radix-router.svg
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24; theme-overrides: { B1: "#8C7B7E"; B2: "#C25B73"; N2: "#C25B73" } } }
style.fill: transparent

direction: down
*.style.font-size: 18

root: "/"
docs: "documents/"
count: "count → 1"
id: ":id → 2" {style.fill: "#fff4d6"}
static: "static/"
path: "*path → 3" {style.fill: "#fff4d6"}
root -> docs: {style.stroke: "#b5523b"; style.stroke-width: 3}
docs -> count
docs -> id: {style.stroke: "#b5523b"; style.stroke-width: 3}
root -> static
static -> path

q: "find(\"/documents/42\")\n→ 2\nid = \"42\"" {
  shape: page
  near: center-right
  style.fill: "#F4F1EA"
}
